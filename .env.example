# ── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# gpt-4o-mini is cheapest; swap to gpt-4o for higher quality
OPENAI_MODEL=gpt-4o-mini

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Path to a Google service account JSON file (downloaded from GCP Console)
GOOGLE_SHEETS_CREDENTIALS_JSON=./credentials.json
# Leave blank until you create your sheet; the app will still start without it
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_PARENT_TAB=Parents
GOOGLE_SHEETS_STUDENT_TAB=Students
GOOGLE_SHEETS_AUDIT_TAB=AuditLog
GOOGLE_SHEETS_REVIEW_TAB=HumanReview

# ── Vapi (voice calls) ────────────────────────────────────────────────────────
VAPI_API_KEY=
# true  → no real call made, returns fixture transcript from test_data/
# false → uses VAPI_API_KEY for real calls
VAPI_MOCK_MODE=true

# ── WhatsApp (Twilio or compatible) ──────────────────────────────────────────
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=whatsapp:+14155238886
WHATSAPP_MOCK_MODE=true

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_MOCK_MODE=true

# ── App behaviour ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Quiet hours: no outreach sent outside this window (24h clock, local time)
QUIET_HOURS_START=21
QUIET_HOURS_END=8

# Confidence score below this triggers human review (0.0–1.0)
CONFIDENCE_THRESHOLD=0.75

# External call retry settings
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE=2

# How long to keep in-memory session state (seconds)
SESSION_TTL_SECONDS=3600
